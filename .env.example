# ══════════════════════════════════════════════════════════════
#  workhub — variáveis de ambiente
#  Copie este arquivo para .env e preencha antes de subir.
#  NUNCA commite o .env. Veja SETUP.md para saber de onde
#  tirar cada valor.
# ══════════════════════════════════════════════════════════════

# ── Banco de dados ────────────────────────────────────────────
POSTGRES_DB=workhub
POSTGRES_USER=workhub
POSTGRES_PASSWORD=                     # você escolhe
DATABASE_URL=postgresql+asyncpg://workhub:MESMA_SENHA_ACIMA@db:5432/workhub

# ── Segredos gerados localmente ───────────────────────────────
APP_SECRET_KEY=                             # veja SETUP.md → Passo 1
ENCRYPTION_KEY=                             # veja SETUP.md → Passo 2
ADMIN_PASSWORD_HASH=                        # veja SETUP.md → Passo 3

# ── 2FA (opcional) ────────────────────────────────────────────
TOTP_SECRET=                                # veja SETUP.md → Passo 4 (deixe vazio para desativar)

# ── Sessão ────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=60

# ── Ambiente ──────────────────────────────────────────────────
APP_ENV=production
# Use APP_ENV=development para dev local (CORS + cookie sem Secure)

# ── Rede / proxy ──────────────────────────────────────────────
DOMAIN=                                     # ex: meusite.com ou IP da VPS
IP_ALLOWLIST=0.0.0.0/0                      # restrinja ao seu IP fixo em produção

# ── Claude / Worker ───────────────────────────────────────────
CLAUDE_HOME=/home/SEU_USUARIO/.claude       # caminho real na VPS
ANTHROPIC_API_KEY=                          # veja SETUP.md → Passo 5

# ── Google Calendar (FEAT-07) — preencher quando implementar ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── iCloud Calendar (FEAT-07) — preencher quando implementar ──
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=

# ── LinkedIn (FEAT-11 — Fase 2) — preencher quando implementar
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Caminho das skills do Claude Desktop (para listar/importar). macOS:
CLAUDE_DESKTOP_SKILLS=/Users/SEU_USUARIO/Library/Application Support/Claude/local-agent-mode-sessions
